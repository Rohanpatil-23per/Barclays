# Copy this to .env.local and set your actual backend URLs
# Default: all services on localhost with standard ports

VITE_ORCHESTRATOR_URL=http://localhost:8000
VITE_LAYER1_URL=http://localhost:8001
VITE_LAYER2_URL=http://localhost:8002
VITE_LAYER3_URL=http://localhost:8003
VITE_LAYER4_URL=http://localhost:8004
VITE_LAYER5_URL=http://localhost:8005

# WireGuard mesh example (when running distributed):
# VITE_ORCHESTRATOR_URL=http://10.0.0.1:8000
# VITE_LAYER1_URL=http://10.0.0.1:8001
# ... etc
